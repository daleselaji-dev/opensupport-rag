# LM Studio exposes OpenAI-compatible chat and embedding endpoints locally.
# For the recommended learning mode (app runs on Windows), keep localhost.
# For the all-Docker mode, replace localhost with host.docker.internal and
# start LM Studio with a host binding that Docker can reach.
LLM_PROVIDER=lmstudio
QDRANT_URL=http://localhost:16333
CHAT_BASE_URL=http://localhost:1234/v1
CHAT_API_KEY=lm-studio
EMBEDDING_PROVIDER=lmstudio
EMBEDDING_BASE_URL=http://localhost:1234/v1
EMBEDDING_API_KEY=lm-studio
DOCKER_LM_STUDIO_BASE_URL=http://host.docker.internal:23145/v1
DOCKER_EMBEDDING_BASE_URL=http://host.docker.internal:23145/v1

# Replace these with identifiers returned by http://localhost:1234/v1/models.
# Recommended local embedding: Qwen3-Embedding-0.6B-GGUF.
EMBEDDING_MODEL=your-embedding-model-id
CHAT_MODEL=your-chat-model-id
EMBEDDING_FAMILY=qwen

COLLECTION_NAME=opensupport_v01
SPARSE_COLLECTION_NAME=opensupport_qwen_v02_sparse
CONTEXTUAL_COLLECTION_NAME=opensupport_qwen_v05_contextual
CONTEXTUAL_SPARSE_COLLECTION_NAME=opensupport_qwen_v05_contextual_sparse
CONTEXTUAL_CHUNK_CHARS=1800
CONTEXTUAL_CHUNK_OVERLAP=220
PDF_COLLECTION_NAME=opensupport_qwen_v08_pdf_pages
PDF_SPARSE_COLLECTION_NAME=opensupport_qwen_v08_pdf_pages_sparse
SPARSE_MODEL=qdrant/bm25
NATIVE_SPARSE_ENABLED=true
# V0.4 is opt-in. Install requirements-reranker.txt before enabling it.
RERANKER_ENABLED=false
RERANKER_PROVIDER=llama_cpp
RERANKER_BASE_URL=http://localhost:23146
RERANKER_MODEL=qwen3-reranker-0.6b-q8_0.gguf
RERANKER_DEVICE=cpu
RERANKER_CANDIDATE_K=50
RERANKER_FINAL_K=3
RERANKER_TIMEOUT_S=120
RERANKER_BATCH_SIZE=8
RERANKER_TEXT_CHARS=1600
INSTALL_RERANKER=false
DOCKER_RERANKER_BASE_URL=http://host.docker.internal:23146
AGENT_ENABLED=false
CACHE_ENABLED=true
CACHE_TTL_S=300
EMBEDDING_TIMEOUT_S=45
CHAT_TIMEOUT_S=120
MAX_MODEL_CONCURRENCY=2
RATE_LIMIT_PER_MINUTE=60
GRAPH_ENABLED=false
NEO4J_URL=bolt://localhost:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=opensupport-dev-password
GUIDANCE_TOP_K=3
COMPLAINT_TOP_K=3
CHAT_MAX_TOKENS=1200
MAX_CONTEXT_CHARS=1000
CITATION_REPAIR_MAX_TOKENS=500
MIN_CITATION_COVERAGE=0.8

# V0.0 Data Foundation / production profile defaults.
DATA_DIR=data
DATA_PIPELINE_VERSION=v0.0-data-foundation-1
POSTGRES_URL=postgresql+psycopg://opensupport:opensupport@localhost:15432/opensupport
MINIO_ENDPOINT=localhost:19000
MINIO_ACCESS_KEY=opensupport
MINIO_SECRET_KEY=opensupport-dev-secret
MINIO_BUCKET=opensupport-raw
REDIS_URL=redis://localhost:16379/0
CELERY_APP_NAME=opensupport
OTEL_EXPORTER_ENDPOINT=http://localhost:14318
PROMETHEUS_PORT=19090
LANGFUSE_HOST=http://localhost:13000
TRUTH_SOURCE_REQUIRED=false
STORAGE_PROBE_ENABLED=false
TRACE_PERSISTENCE_ENABLED=false
OTEL_ENABLED=false

# Online Qwen fallback (do not commit a real key; replace WorkspaceId):
# EMBEDDING_PROVIDER=qwen-api
# EMBEDDING_BASE_URL=https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=sk-your-dashscope-key
# EMBEDDING_MODEL=qwen3.7-text-embedding
# EMBEDDING_FAMILY=qwen-api
